# Base URL of the Spring Boot API (no trailing slash). Leave empty in development to use the Vite /api proxy.
# Placeholder values only; never commit secrets.
VITE_API_BASE_URL=

# OIDC (Keycloak). Both values are required to enable "Continue with company SSO".
# The browser client is public: Authorization Code with PKCE, no client secret.
VITE_OIDC_AUTHORITY=http://127.0.0.1:8180/realms/eka
VITE_OIDC_CLIENT_ID=eka-frontend
